# Backend API
# Local dev: talk to the live server directly.
VITE_API_URL=http://168.144.185.66:4000

# Public HTTPS URL for the current Android APK.
# When unset, the download CTA opens a support email instead of a broken link.
VITE_APK_DOWNLOAD_URL=

# Netlify / production: leave VITE_API_URL unset (or empty).
# The site calls /api/* on the same HTTPS origin; netlify.toml proxies to the backend.
# Do NOT set http://168.144.185.66:4000 on Netlify — browsers block HTTP from HTTPS pages.
# Even if set by mistake, production builds ignore non-HTTPS VITE_API_URL values.
