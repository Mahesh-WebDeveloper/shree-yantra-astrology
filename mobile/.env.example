# Production / live API (HTTPS)
EXPO_PUBLIC_API_URL=https://api.example.com

# Local backend testing (phone APK + PC on same WiFi):
# EXPO_PUBLIC_API_URL=http://192.168.0.235:4000

# Client widget credentials from MSG91 Dashboard > OTP Widget. These are not the
# private MSG91 Authkey; the Authkey must exist only in backend/.env.
EXPO_PUBLIC_MSG91_WIDGET_ID=
EXPO_PUBLIC_MSG91_WIDGET_TOKEN=
