# ---- Server ----
PORT=4000

# ---- Local MongoDB (MongoDB Compass / local mongod) ----
# Compass se connect karte ho wahi URI. Default local, koi auth nahi.
MONGO_URI=mongodb://127.0.0.1:27017/shree_yantra

# ---- VedAstro (PRIMARY astrology source; local astronomy-engine = automatic fallback) ----
# FREE tier = 15 requests/minute (no key). PAID = Unlimited (sk_live_... key).
# PAID karne ke liye: (1) key yahan daalo, (2) VEDASTRO_TIER=paid. env tier=paid hone par
# key har VedAstro call me lagti hai (DB Settings toggle ki zarurat nahi).
VEDASTRO_API_KEY=
# free | paid
VEDASTRO_TIER=free
# Ayanamsa — India standard = LAHIRI
VEDASTRO_AYANAMSA=LAHIRI

# ---- Claude AI (rashifal / chat) — pay-as-you-go, subscription NAHI. Abhi optional. ----
ANTHROPIC_API_KEY=

# ---- Auth (baad ke phase ke liye) ----
JWT_SECRET=change_me_to_a_long_random_string

# ---- MSG91 mobile OTP (backend only; never expose MSG91_AUTHKEY to the app) ----
MSG91_AUTHKEY=
# MSG91 Widget ID/token belong in the mobile build environment. The backend uses
# only MSG91_AUTHKEY to validate the short-lived widget access-token server-side.
# OTP template ID from MSG91 OTP dashboard (different from the Jio DLT template ID)
MSG91_OTP_TEMPLATE_ID=
# Do not use an SMS template ID here. Copy the ID from MSG91 Dashboard > OTP.
MSG91_DLT_TEMPLATE_ID=1277178618551233526
MSG91_SENDER_ID=SYASTY
MSG91_PE_ID=1201178573075062694
# Optional separate HMAC secret for hashing OTP throttle identifiers
OTP_HASH_SECRET=
MSG91_OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=45
OTP_MAX_SEND_ATTEMPTS=3
OTP_MAX_RESEND_ATTEMPTS=2
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_MAX_IP_SEND_ATTEMPTS=10
OTP_MAX_IP_VERIFY_ATTEMPTS=30
OTP_SEND_WINDOW_SECONDS=900
OTP_VERIFY_WINDOW_SECONDS=900
MSG91_TIMEOUT_MS=20000

# ---- Gemini AI ----
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Extra Gemini keys (comma-separated) — auto-tried when the primary key's models
# hit their daily quota. Each key has its own quota, so more keys = more free AI.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash

# ---- OpenRouter — AUTOMATIC fallback jab Gemini quota/fail ho (FREE models, $0 balance) ----
# Key https://openrouter.ai se FREE milti hai (sk-or-v1-...), bina credit card ke.
# Service ke andar pura free-model chain (llama-3.3 / qwen3 / gpt-oss / gemma / hermes / nemotron)
# circuit-breaker ke saath try hota hai → AI kabhi down/slow feel nahi hota.
OPENROUTER_API_KEY=
# Extra OpenRouter keys (comma-separated) — auto-tried when the primary key is rate-limited.
OPENROUTER_API_KEYS=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Optional: extra fallback models (CSV) — paid bhi daal sakte ho jab credits ho.
OPENROUTER_FALLBACK_MODELS=

# ---- Groq (very fast free LLM, OpenAI-compatible) — fallback between Gemini & OpenRouter ----
# Key https://console.groq.com se FREE milti hai. Models: llama-3.3-70b-versatile, llama-3.1-8b-instant.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- ofox.ai (OpenAI-compatible aggregator) — last-resort fallback ----
# Default free model z-ai/glm-4.7-flash:free. Paid models need account credits.
OFOX_API_KEY=
OFOX_MODEL=z-ai/glm-4.7-flash:free

# ---- YouTube import/search for library media (optional; backend only) ----
YOUTUBE_API_KEY=
YOUTUBE_REGION_CODE=IN

# ---- Admin dashboard ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_admin_password
ADMIN_NAME=Admin
ADMIN_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://shreeyantra.app,https://www.shreeyantra.app,https://tiny-fudge-8b01c1.netlify.app
# Open CORS for all origins (marketing previews). Set to false to lock down again.
CORS_ALLOW_ALL=true

# ---- Razorpay Subscriptions (server only; never put KEY_SECRET in the mobile app) ----
# First use Test Mode credentials and run: npm run setup:razorpay-plan
# Copy the printed plan id below. Create a separate webhook secret in Razorpay Dashboard.
PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=
# 1200 monthly cycles is Razorpay's 100-year maximum; cancellation remains available anytime.
RAZORPAY_TOTAL_BILLING_CYCLES=1200
RAZORPAY_CHECKOUT_EXPIRY_MINUTES=30

# ---- Observability (structured logs + admin dashboard) ----
# Slow request threshold for WARN + api.request.slow events (milliseconds)
OBS_SLOW_REQUEST_MS=1000
# MongoDB TTL for ObservabilityLog documents (seconds). Default 30 days.
OBS_LOG_RETENTION_SEC=2592000
# MongoDB TTL for ApiRequestMetric documents (seconds). Default 14 days.
OBS_METRICS_RETENTION_SEC=1209600
# Minimum log level persisted to MongoDB: debug | info | warn | error | fatal
OBS_LOG_PERSIST_LEVEL=info
# Console log level: debug | info | warn | error | fatal
LOG_LEVEL=info
# Set json to force JSON logs in development
LOG_FORMAT=json
# Optional: Sentry DSN for crash aggregation (not required; fail-safe if unset)
SENTRY_DSN=
